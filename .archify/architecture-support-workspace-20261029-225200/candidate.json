  "cards": [
    {
      "dot": "cyan",
      "title": "Two front doors",
      "items": [
        "Customers use the intake app on port 5174",
        "Employees use the workspace on port 5173",
        "Both Vite apps proxy /api to Uvicorn :8000"
      ]
    },
    {
      "dot": "emerald",
      "title": "One API process",
      "items": [
        "FastAPI stores tickets, then runs LangGraph in-process",
        "Jev classifies first; Gemini is the second opinion and drafter",
        "Screenshots stay on the mounted intake-uploads volume"
      ]
    },
    {
      "dot": "amber",
      "title": "Nothing is sent",
      "items": [
        "Results wait for approve, edit, reject, or reassign",
        "The reviewed text is an audit row, not an outbound message"
      ]
    }
