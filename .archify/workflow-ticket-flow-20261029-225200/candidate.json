  "cards": [
    {
      "dot": "cyan",
      "title": "Cascade",
      "items": [
        "Jev runs first in jev and cascade modes",
        "Gemini runs when Jev is unsure or fails, or when the batch is gemini-only",
        "Disagreement still continues through lookup and draft"
      ]
    },
    {
      "dot": "amber",
      "title": "Where it stops",
      "items": [
        "Only an empty ticket skips lookup and draft",
        "Any escalation reason marks the result escalated and still waits for a person",
        "A failed draft cannot be reviewed; nothing is sent to the customer"
      ]
    }
