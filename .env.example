OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
GEMINI_MODEL=google/gemini-3.8-flash
GEMINI_STRONG_MODEL=google/gemini-2.5-pro
# Database-backed drafting uses ANTHROPIC_MODEL when set, otherwise GEMINI_MODEL.
ANTHROPIC_MODEL=
# Set false explicitly for classification-only; --no-db also skips drafting.
RAG_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBED_DIM=768
# EMBED_DIM is fixed by the pgvector schema. Reindex sources after a model change.
KB_TOP_K=5
KB_MIN_SIMILARITY=0.3
# USD per 1M input tokens; fallback estimate when OpenRouter omits cost.
# Source (2026-10-17): https://developers.openai.com/api/docs/models/text-embedding-3-small
# Update with EMBEDDING_MODEL. Reported provider cost always takes precedence.
PRICE_EMBEDDING_IN=0.02
JEV_MODEL=jev-1.13.0
T_JEV=0.6
T_GEM=0.66
JEV_MIN_TOP_PROB=0.60
PIPELINE_CONCURRENCY=20
MAX_STATE_CHARS=6000
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_S=30
# Optional override. Empty uses GEMINI_MODEL. The model must support vision and structured output.
INTAKE_MODEL=google/gemini-2.5-flash
INTAKE_TIMEOUT_S=60
INTAKE_MAX_MODEL_REQUESTS=3
INTAKE_UPLOAD_DIR=data/intake-uploads
INTAKE_MAX_IMAGE_BYTES=5242880
INTAKE_MAX_IMAGE_PIXELS=20000000
INTAKE_MAX_IMAGES_PER_MESSAGE=3
INTAKE_MAX_IMAGES_PER_SESSION=10
DATABASE_URL=postgresql+psycopg://support:support@localhost:5433/support
TEST_DATABASE_URL=postgresql+psycopg://support:support@localhost:5433/support_test
# In WSL, export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt in the launching
# shell; setting it only in this dotenv file does not configure SDK TLS trust.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
