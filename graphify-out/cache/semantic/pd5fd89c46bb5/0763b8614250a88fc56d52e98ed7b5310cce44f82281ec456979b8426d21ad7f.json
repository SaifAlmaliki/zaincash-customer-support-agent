{"nodes": [{"id": "data_taxonomy_taxonomy", "label": "Support Taxonomy", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth for categories, teams, and priorities, cited as spec section 4."}, {"id": "data_taxonomy_priority_scale", "label": "Priority Scale", "file_type": "rationale", "source_file": "data/taxonomy.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P1 is money at risk now or fraud. P2 is money lost or stuck. P3 is a blocked service. P4 is an information request. Each category also has a minimum priority."}, {"id": "data_taxonomy_failed_transfer", "label": "Failed Transfer", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "failed_transfer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transfer that failed, stuck, or left the wallet but did not arrive. Team Payments Ops, minimum P2, requires amount and date, and needs a transaction. Not for wrong_recipient or bill_payment."}, {"id": "data_taxonomy_wrong_recipient", "label": "Wrong Recipient", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "wrong_recipient", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Money sent to the wrong number or person by mistake. Team Disputes, minimum P2, requires amount, and needs a transaction. Not for a technical failed_transfer."}, {"id": "data_taxonomy_login_access", "label": "Login Access", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "login_access", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cannot log in, forgot PIN or password, verification code not arriving, or account locked. Team Account & Security, minimum P3, no transaction. Not for fraud_report."}, {"id": "data_taxonomy_agent_dispute", "label": "Agent Dispute", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "agent_dispute", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Problem with a ZainCash agent or shop: cash-in or cash-out not credited, extra fee, or refused service. Team Agent Network, minimum P2, requires amount, and needs a transaction."}, {"id": "data_taxonomy_card_issue", "label": "Card Issue", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "card_issue", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ZainCash Mastercard or virtual card declined, blocked, not delivered, or charged twice. Team Cards, minimum P3, no transaction. Not for wallet failed_transfer."}, {"id": "data_taxonomy_bill_payment", "label": "Bill Payment", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "bill_payment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bill or top-up failed or was not applied by the biller. Team Payments Ops, minimum P3, requires amount, and needs a transaction. Not for person-to-person failed_transfer."}, {"id": "data_taxonomy_account_kyc", "label": "Account KYC", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "account_kyc", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification, account level, ID documents, limits, or changing account details. Team Account & Security, minimum P4, no transaction. Not for login_access."}, {"id": "data_taxonomy_refund_request", "label": "Refund Request", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "refund_request", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Money back from a merchant purchase or a cancelled service. Team Disputes, minimum P3, requires amount, and needs a transaction. Not for wrong_recipient or failed_transfer."}, {"id": "data_taxonomy_fraud_report", "label": "Fraud Report", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "fraud_report", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scam, OTP or PIN request, unauthorized transactions, or a hacked account. Team Account & Security, minimum P1, no transaction required. Not for simply forgetting a PIN."}, {"id": "data_taxonomy_app_bug", "label": "App Bug", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "app_bug", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app crashes, errors, or a feature fails, with no money lost. Team Tech Support, minimum P3, no transaction. Not for failed_transfer or bill_payment."}, {"id": "data_taxonomy_general_inquiry", "label": "General Inquiry", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "general_inquiry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Questions about fees, limits, how to do something, agent locations, or promotions. Team General Care, minimum P4, no transaction. Not for a problem that already happened."}, {"id": "data_taxonomy_other", "label": "Other", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "other", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything that does not fit the other categories, including complaints with no clear request. Team General Care, minimum P4, no transaction. Unknown classifier labels are mapped here."}, {"id": "data_taxonomy_payments_ops", "label": "Payments Ops", "file_type": "concept", "source_file": "data/taxonomy.yaml", "source_location": "teams", "source_url": null, "captured_at": null, 