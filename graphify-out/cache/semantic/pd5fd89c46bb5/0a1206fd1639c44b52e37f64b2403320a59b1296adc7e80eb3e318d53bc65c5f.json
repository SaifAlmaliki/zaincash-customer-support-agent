{"nodes": [{"id": "readme_support_pipeline", "label": "ZainCash Support Pipeline", "file_type": "concept", "source_file": "README.md", "source_location": "How a ticket flows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Back-office batch pipeline for Iraqi-dialect ZainCash tickets. It classifies, sets priority, extracts details, matches a transaction, routes to a team, and drafts a reply for a person to approve. It is not a chatbot and it never sends a reply on its own."}, {"id": "readme_jev", "label": "Jev", "file_type": "concept", "source_file": "README.md", "source_location": "Models", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TypeSafe System One model used for fast, cheap classification. Its confidence scores are calibrated, and it picks extracted values from the ticket text so it cannot invent them."}, {"id": "readme_gemini_3_8_flash", "label": "Gemini 3.8 Flash", "file_type": "concept", "source_file": "README.md", "source_location": "Models", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second opinion on uncertain tickets and the fallback extractor, called through OpenRouter as google/gemini-3.8-flash. RAG drafting is planned for a later phase. The direct Google API was blocked on this network; OpenRouter was verified with the system CA bundle."}, {"id": "readme_openrouter", "label": "OpenRouter", "file_type": "concept", "source_file": "README.md", "source_location": "Quickstart", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gemini requests use https://openrouter.ai/api/v1 through langchain-openrouter. Unqualified gemini-* names are prefixed with google/. Costs use OpenRouter's reported charge when present; the token fallback defaults to $0.75 input and $3.75 output per million tokens."}, {"id": "readme_cascade_mode", "label": "Cascade Mode", "file_type": "rationale", "source_file": "README.md", "source_location": "Quickstart", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default run mode. Jev classifies first and Gemini is asked three times only when Jev is not confident. Cascade needs both TYPESAFE_API_KEY and OPENROUTER_API_KEY. jev mode can still use OpenRouter for fallback extraction."}, {"id": "readme_human_approval", "label": "Human Approval Gate", "file_type": "rationale", "source_file": "README.md", "source_location": "How a ticket flows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every path ends with a person. If the pipeline is unsure, or a safety check fails, it escalates with a short note. The agent approves, edits, or rejects, and only then sends the reply. Nothing is sent automatically."}, {"id": "readme_red_flags", "label": "Red-Flag Escalation", "file_type": "rationale", "source_file": "README.md", "source_location": "How a ticket flows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escalate when there is fraud, several issues, missing information, a transaction that was not found, or an amount mismatch. A draft must cite policy, must not invent numbers, and must never ask for an OTP or PIN."}, {"id": "readme_nulldrafter", "label": "NullDrafter", "file_type": "concept", "source_file": "README.md", "source_location": "Status", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 reply generation still uses NullDrafter. RAG drafting is Plan 3, so the verified pipeline does not yet write customer replies."}, {"id": "readme_live_smoke", "label": "Plan 1 Live Smoke", "file_type": "concept", "source_file": "README.md", "source_location": "Status", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 2026-10-07, in-memory jev, gemini, and cascade runs each processed five fixtures with no failures using google/gemini-3.8-flash. Two database cascade runs kept five ticket rows. These checks are connectivity tests; held-out accuracy is Plan 2."}], "edges": [{"source": "readme_support_pipeline", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_pipeline", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Design", "weight": 1.0}, {"source": "readme_support_pipeline", "target": "readme_jev", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Models", "weight": 1.0}, {"source": "readme_support_pipeline", "target": "readme_gemini_3_8_flash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Models", "weight": 1.0}, {"source": "readme_support_pipeline", "target": "readme_cascade_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "How a ticket flows", "weight": 1.0}, {"source": "readme_support_pipeline", "target": "readme_human_approval", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "How a ticket flows", "weight": 1.0}, {"source": "readme_gemini_3_8_flash", "target": "readme_openrouter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Models", "weight": 1.0}, {"source": "readme_cascade_mode", "target": "readme_jev", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "How a ticket flows", "weight": 1.0}, {"source": "readme_cascade_mode", "target": "readme_gemini_3_8_flash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.