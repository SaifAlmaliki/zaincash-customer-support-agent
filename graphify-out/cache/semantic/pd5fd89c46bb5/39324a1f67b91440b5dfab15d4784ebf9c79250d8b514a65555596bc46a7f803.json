{"nodes": [{"id": "docs_verification_2026_10_07_support_workspace_ui_verification", "label": "Workspace UI Verification", "file_type": "document", "source_file": "docs/verification/2026-10-07-support-workspace-ui.md", "source_location": "Scope", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records the implemented UI and live API. Backend pytest reported 134 passed, frontend tests 6 passed, and browser checks covered preview isolation, a one-ticket Jev run, a saved review that survived reload, document upload and deletion, and a 390px layout."}, {"id": "docs_verification_2026_10_07_support_workspace_ui_review_fixes", "label": "Independent Review Fixes", "file_type": "rationale", "source_file": "docs/verification/2026-10-07-support-workspace-ui.md", "source_location": "Independent review and fixes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflicting ticket content is rejected after re-reading durable rows, and the graph runs on the persisted text. Preview uploads are disabled. The reply editor stays mounted so unsaved text survives reassignment. Summaries count only committed outcomes. Queues over 500 tickets load every API page before client filtering or export."}, {"id": "docs_verification_2026_10_07_support_workspace_ui_capability_boundaries", "label": "Verified Capability Boundaries", "file_type": "rationale", "source_file": "docs/verification/2026-10-07-support-workspace-ui.md", "source_location": "Capability boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NullDrafter does not generate replies. Document storage does not embed files into pgvector. The evaluation screen views imported reports and does not run a held-out evaluator. Those limits are shown in the UI and documented in the workspace README. Live and preview state stay separate so preview data is never reported as measured model output."}], "edges": 