{"nodes": [{"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_plan", "label": "Plan 1 Core Pipeline", "file_type": "document", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Goal", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build a command-line batch pipeline that normalizes Iraqi-dialect tickets, classifies them, extracts details without inventing values, matches mock transactions, applies routing rules, and persists results to Postgres."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_roadmap", "label": "Five-Plan Roadmap", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "This plan is 1 of 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 is the core pipeline and CLI. Plan 2 is synthetic data and evaluation. Plan 3 is knowledge-base RAG, the drafting agent, and guardrails. Plan 4 is FastAPI and the React review UI. Plan 5 is the weekly report, docs, CI, and the full compose stack."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_langgraph", "label": "LangGraph StateGraph", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One node per stage: prepare, jev_classify, gemini_classify, extract, lookup, decide, and draft. Plain unit-tested Python functions choose the next node so routing stays testable instead of hiding inside the model."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_model_protocols", "label": "Model Protocols and Fakes", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jev is reached through langchain-typesafe and Gemini through structured output. Each client sits behind a small protocol so unit tests use fakes and do not call the network. langchain-typesafe is pinned at 0.0.1a3 because it is alpha."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_thresholds", "label": "Classification Thresholds", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jev is pinned to jev-1.13.0 and jev-latest is forbidden because thresholds are tuned to a specific version. Defaults are T_JEV 0.6, T_GEM 0.66, and JEV_MIN_TOP_PROB 0.60. T_GEM 0.66 is chosen so two of three Gemini samples agreeing counts as confident."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_safety_constraints", "label": "Pipeline Safety Constraints", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An extracted field must be a substring of the ticket after digit conversion, or null. No code path sends a customer message. Card numbers are masked to the last four digits before storage. Tickets longer than MAX_STATE_CHARS (6000) are truncated before Jev."}], "edges": [{"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_plan", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_pipeline", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Spec", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_roadmap", "target": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "This plan is 1 of 5", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_roadmap", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_synthetic_eval", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "This plan is 1 of 5", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_roadmap", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_bounded_agent", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "This plan is 1 of 5", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_roadmap", "target": "docs_superpowers_plans_2026_10_07_support_workspace_ui_plan", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "This plan is 1 of 5", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_roadmap", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_weekly_report", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "This plan is 1 of 5", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_langgraph", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_langgraph", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Architecture", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_thresholds", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_schema_choices", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Global Constraints", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_safety_constraints", "target": "backend_app_pipeline_runner_prepare", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Global Constraints", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_safety_constraints", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_no_send", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Global Constraints", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_model_protocols", "target": "docs_superpowers_specs_2026_10_07_support_pipeline_design_langgraph", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline.md", "source_location": "Architecture", "weight": 1.0}], "hyperedges": []}