{"nodes": [{"id": "customer_support_ui_readme_workspace", "label": "Support Workspace", "file_type": "concept", "source_file": "customer-support-ui/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React, TypeScript, and shadcn/ui back office for Topic 06. Staff upload or paste Iraqi-dialect tickets, inspect evidence, and record review decisions. The UI does not implement its own classifier; model execution reuses pipeline/factory.py and pipeline/graph.py. API keys stay on the server."}, {"id": "customer_support_ui_readme_live_workspace", "label": "Live Workspace", "file_type": "rationale", "source_file": "customer-support-ui/README.md", "source_location": "Workspace modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses FastAPI and PostgreSQL so runs, progress, documents, and reviews persist. Failed requests stay errors. The UI does not replace a failed live call with simulated success."}, {"id": "customer_support_ui_readme_preview_workspace", "label": "Preview Workspace", "file_type": "rationale", "source_file": "customer-support-ui/README.md", "source_location": "Workspace modes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses labelled fixtures in src/data/preview.ts. Edits stay in the session and never call live mutations. Preview data is not measured output and is not the hackathon held-out dataset."}, {"id": "customer_support_ui_readme_pipeline_strip", "label": "Pipeline Stage Strip", "file_type": "rationale", "source_file": "customer-support-ui/README.md", "source_location": "Workflow", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The One pipeline strip is an informational map from stages to implementation files. Clicking a stage opens a description. It does not execute the pipeline, and ticket details show only stage events the API actually recorded."}, {"id": "customer_support_ui_readme_nulldrafter", "label": "Workspace NullDrafter Boundary", "file_type": "concept", "source_file": "customer-support-ui/README.md", "source_location": "Current capability boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated drafts are not connected because the backend uses NullDrafter, so a reviewer writes the reply. Uploaded documents show Awaiting indexing because RAG retrieval is not connected. Weekly counts are real; evaluation only displays an imported report and does not run a model eval."}], "edges": [{"source": "customer_support_ui_readme_workspace", "target": "backend_app_pipeline_runner_graph_orchestration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "customer-support-ui/README.md", "source_location": "Modular file map", "weight": 1.0}, {"source": "customer_support_ui_readme_workspace", "target": "docker_compose_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "customer-support-ui/README.md", "source_location": "Run locally", "weight": 1.0}, {"source": "customer_support_ui_readme_workspace", "target": "customer_support_ui_readme_live_workspace", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "customer-support-ui/README.md", "source_location": "Workspace modes", "weight": 1.0}, {"source": "customer_support_ui_readme_workspace", "target": "customer_support_ui_readme_preview_workspace", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "customer-support-ui/README.md", "source_location": "Workspace modes", "weight": 1.0}, {"source": "customer_support_ui_readme_pipeline_strip", "target": "backend_app_pipeline_runner_graph_orchestration", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "customer-su