{"nodes": [{"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_part3_batch_runner", "label": "Batch Runner", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "run_batch uses graph.abatch with a concurrency cap and return_exceptions so one failed ticket does not stop the batch. Empty text escalates with no model call. Confident Jev skips Gemini. A Jev failure in cascade mode degrades to Gemini."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_part3_idempotent_repository", "label": "Idempotent Persistence", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tickets upsert on external_id and results upsert on (run_id, ticket_id), so a repeated batch does not duplicate rows. Knowledge-base tables are left out because Plan 3 PGVector manages its own tables. init_db still creates the vector extension. create_all is used instead of Alembic because the data is synthetic and resettable."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_part3_support_cli", "label": "support CLI", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typer app with init-db, seed-db, and run-batch. Modes are jev, gemini, and cascade. --no-db uses an in-memory transaction repo. The same pipeline code is what the later API and evaluation harness call."}, {"id": "docs_superpowers_plans_2026_10_07_plan1_core_pipeline_part3_nulldrafter", "label": "NullDrafter", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 drafter returns an empty DraftResult and adds no escalation reasons. Plan 3 replaces it with the RAG agent. Shipping a no-op keeps the graph shape stable before drafting exists."}], "edges": [{"source": "backend_app_pipeline_runner_prepare", "target": "backend_app_pipeline_runner_jev_classify", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "weight": 1.0}, {"source": "backend_app_pipeline_runner_prepare", "target": "backend_app_pipeline_runner_gemini_classify", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "weight": 1.0}, {"source": "backend_app_pipeline_runner_jev_classify", "target": "backend_app_pipeline_runner_gemini_classify", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "weight": 1.0}, {"source": "backend_app_pipeline_runner_jev_classify", "target": "backend_app_pipeline_runner_extract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "weight": 1.0}, {"source": "backend_app_pipeline_runner_gemini_classify", "target": "backend_app_pipeline_runner_extract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-10-07-plan1-core-pipeline-part3.md", "source_location": "Task 12", "weight": 1.0}, {"source": "backend_app_pipelin